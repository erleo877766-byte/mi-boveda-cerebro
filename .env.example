# Puerto del servidor
PORT=8787

# Clave API usada por las billeteras (header x-api-key).
# DEBE coincidir con cerebro_api_key configurada en la app.
# Si se deja vacia, se genera automaticamente en el primer arranque y se muestra UNA SOLA VEZ.
CEREBRO_API_KEY=

# Contrasena del dashboard web admin (login).
# Si se deja vacia, se genera automaticamente y se muestra en los logs del primer arranque.
ADMIN_PASSWORD=

# Token secreto para firmar sesiones del dashboard.
SESSION_SECRET=

# ============================================================
# PERSISTENCIA DE DATOS (importante para Render Free)
# ============================================================
# Render Free BORRA el disco local en cada deploy/reinicio, por lo que la DB
# SQLite local no es persistente ahi. Para produccion usa Turso (gratis):
#
#   1. Crea una cuenta en https://turso.tech
#   2. Crea una base:  turso db create cerebro
#   3. Copia la URL y el token:  turso db show --url cerebro  /  turso db tokens create cerebro
#
# TURSO_DATABASE_URL=libsql://tu-base.turso.io
# TURSO_AUTH_TOKEN=eyJ...
#
# Si NO defines estas variables, el servidor usa un archivo SQLite local
# (data/cerebro.db), util para desarrollo en tu PC.
